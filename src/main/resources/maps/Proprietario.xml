<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sqlMap
        PUBLIC "-//ibatis.apache.org//DTD SQL Map 2.0//EN"
        "http://ibatis.apache.org/dtd/sql-map-2.dtd">

<sqlMap namespace="Proprietario">

    <!-- Result Map -->
    <resultMap id="proprietarioResult" class="Proprietario">
        <result property="id" column="id"/>
        <result property="cpfCnpj" column="cpf_cnpj"/>
        <result property="nome" column="nome"/>
        <result property="endereco" column="endereco"/>
    </resultMap>

    <!-- INSERT -->
    <insert id="inserirProprietario" parameterClass="Proprietario">
        <selectKey keyProperty="id" resultClass="int">
            SELECT currval('cadastro.proprietario_id_seq')
        </selectKey>
        INSERT INTO cadastro.proprietario
        (cpf_cnpj, nome, endereco)
        VALUES
        (#cpfCnpj#, #nome#, #endereco#)
    </insert>

    <!-- UPDATE -->
    <update id="atualizarProprietario" parameterClass="Proprietario">
        UPDATE cadastro.proprietario
        SET cpf_cnpj = #cpfCnpj#,
            nome = #nome#,
            endereco = #endereco#
        WHERE id = #id#
    </update>

    <!-- DELETE -->
    <delete id="deletarProprietario" parameterClass="int">
        DELETE FROM cadastro.proprietario
        WHERE id = #id#
    </delete>

    <!-- SELECT ALL -->
    <select id="buscarTodos" resultMap="proprietarioResult">
        SELECT id, cpf_cnpj, nome, endereco
        FROM cadastro.proprietario
        ORDER BY nome
    </select>

    <!-- SELECT BY ID -->
    <select id="buscarPorId" parameterClass="int" resultMap="proprietarioResult">
        SELECT id, cpf_cnpj, nome, endereco
        FROM cadastro.proprietario
        WHERE id = #id#
    </select>

    <!-- SELECT BY CPF/CNPJ -->
    <select id="buscarPorCpfCnpj" parameterClass="string" resultMap="proprietarioResult">
        SELECT id, cpf_cnpj, nome, endereco
        FROM cadastro.proprietario
        WHERE cpf_cnpj = #cpfCnpj#
    </select>

    <!-- COUNT -->
    <select id="contarProprietarios" resultClass="int">
        SELECT COUNT(*)
        FROM cadastro.proprietario
    </select>

</sqlMap>