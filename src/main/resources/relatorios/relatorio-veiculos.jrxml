<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="relatorio-veiculos" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<parameter name="BRASAO_DETRAN" class="java.lang.String"/>
	<parameter name="LOGO_ESTADO_CE" class="java.lang.String"/>
	<parameter name="RODAPE" class="java.lang.String"/>
	<parameter name="QUERY_PROPRIETARIO" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["/home/guilherme/desenvolvimento/projetos/java/CRUD_veiculo_proprietario/src/main/resources/relatorios/"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
  p.id,
  p.cpf_cnpj,
  p.nome,
  p.endereco,
  v.placa,
  v.renavam
FROM cadastro.proprietario p
LEFT JOIN cadastro.veiculo v
  ON v.id_prop = p.id
WHERE
  COALESCE(btrim(CAST($P{QUERY_PROPRIETARIO} AS text)), '') = ''
  OR p.nome ILIKE '%' || CAST($P{QUERY_PROPRIETARIO} AS text) || '%'
ORDER BY
  p.nome,
  p.id,
  v.placa;]]>
	</queryString>
	<field name="id" class="java.lang.Integer">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="cpf_cnpj" class="java.lang.String">
