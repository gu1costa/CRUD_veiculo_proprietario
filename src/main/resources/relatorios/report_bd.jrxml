						<font size="9"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{ve_num_cnpf_cnpj_prop} == null ? "" :
(
    $F{ve_num_cnpf_cnpj_prop}.length() == 11 ?
    ($F{ve_num_cnpf_cnpj_prop}.substring(0, 3) + "." + $F{ve_num_cnpf_cnpj_prop}.substring(3, 6) + "." + $F{ve_num_cnpf_cnpj_prop}.substring(6, 9) + "-" + $F{ve_num_cnpf_cnpj_prop}.substring(9, 11)) :
    ($F{ve_num_cnpf_cnpj_prop}.length() == 14 ?
        ($F{ve_num_cnpf_cnpj_prop}.substring(0, 2) + "." + $F{ve_num_cnpf_cnpj_prop}.substring(2, 5) + "." + $F{ve_num_cnpf_cnpj_prop}.substring(5, 8) + "/" + $F{ve_num_cnpf_cnpj_prop}.substring(8, 12) + "-" + $F{ve_num_cnpf_cnpj_prop}.substring(12, 14)) :
        $F{ve_num_cnpf_cnpj_prop})
)]]></textFieldExpression>
				</textField>
