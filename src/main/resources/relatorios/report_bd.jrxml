	<parameter name="cpfCnpj" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT dt_munic_nome, ve_placa, ve_chassi, ve_renavam, ve_uf_jurid, ve_nom_prop,
       ve_num_cnpf_cnpj_prop, ve_endereco_arrend_prop, ve_bairro_arrend_prop,
       ve_nome_marc_mod, ve_nome_cor, ve_nome_tipo
FROM veiculo.veiculo_all va
WHERE va.ve_num_cnpf_cnpj_prop = ($P{cpfCnpj}::text)
ORDER BY va.ve_num_cnpf_cnpj_prop, va.ve_nom_prop, va.ve_placa
LIMIT 10]]>
	</queryString>
